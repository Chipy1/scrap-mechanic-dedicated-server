# Copy to .env (or run scripts/import-creds.sh) and never commit .env.
SERVER_STEAM_USER_LOGIN='steam-account-name'
SERVER_STEAM_USER_PASSWORD='steam-password'

# The initialized SQLite save that must exist in the sm_seed volume.
SAVE_NAME='something-test'
IS_CUSTOM_GAME=false

# REST API / Prometheus bearer token. Generate a long random value.
SM_API_TOKEN='change-me-generate-a-long-random-token'
SM_API_PORT=8080

# Optional; normally discovered from Steam's connection log after login.
SM_STEAM_ID=''

SM_BACKUP_AUTO=true
SM_BACKUP_INTERVAL_MINUTES=15
SM_BACKUP_RETENTION_DAYS=7
SM_BACKUP_RETENTION_WEEKS=4
SM_REQUIRE_SERVER_STOPPED=true

SM_SKIP_UPDATE=false
SM_STEAM_LOGIN_TIMEOUT=1200
SM_GAME_START_TIMEOUT=600
SM_STEAMCMD_TIMEOUT=1800

PUID=1000
PGID=1000
TZ=UTC
